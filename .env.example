# Names only. Real values live in Railway / Vercel (spec §13). Copy to .env for local runs.

# Postgres connection for migrations, seed, loader, export (Supabase project nadav-hq, Frankfurt).
# Use the direct/session connection string of the `postgres` user (needs CREATEROLE).
SUPABASE_DB_URL=
# Optional: PEM of Supabase's root CA; if set, TLS is verified against it (see docs/RAILWAY.md)
SUPABASE_CA_CERT=

# Anthropic key for solo companies. Partner companies use the env var named in their company.yaml.
ANTHROPIC_API_KEY=

# Engine (M2): companies to sync on boot, agents to run once on boot (test only)
HQ_COMPANIES=
HQ_RUN_ON_BOOT=

# Seed (pnpm db:seed)
OWNER_EMAIL=
OWNER_TELEGRAM_USER_ID=
HQ_BUDGET_MONTH_USD=

# Path to pg_dump 17 (Supabase runs Postgres 17; export-company refuses an older pg_dump)
PG_DUMP=

# Tests only: an empty throwaway Postgres database (never Supabase prod). DB tests skip if unset.
TEST_DATABASE_URL=
